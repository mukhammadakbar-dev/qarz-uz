{
  "name": "@nasiya/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate-cli.ts",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "webhook:set": "node --env-file-if-exists=../../.env --import tsx src/bot/webhook-cli.ts set",
    "webhook:delete": "node --env-file-if-exists=../../.env --import tsx src/bot/webhook-cli.ts delete",
    "webhook:info": "node --env-file-if-exists=../../.env --import tsx src/bot/webhook-cli.ts info",
    "build": "tsup",
    "start": "node dist/main.js",
    "migrate:prod": "node dist/migrate.js",
    "dev:initdata": "node --env-file-if-exists=../../.env --import tsx src/dev/init-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@google/genai": "^2.27.0",
    "@nasiya/nlp": "workspace:*",
    "@nasiya/shared": "workspace:*",
    "@sentry/node": "^11.4.0",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
