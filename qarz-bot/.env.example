# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Backend API base URL
API_BASE_URL=http://localhost:4000

# Must exactly match BOT_SHARED_SECRET on the backend (.env there). Lets this
# bot register personal accounts without the SMS-OTP step, since sharing a
# Telegram contact already proves the user controls the phone number.
# REQUIRED for /register to work — without it, registration from the bot
# fails because the backend falls back to requiring a normal OTP.
# Generate with: openssl rand -hex 24
BOT_SHARED_SECRET=

# Default UI language: uz | ru
DEFAULT_LANG=uz

# --- Webhook mode (optional; default is long polling) ---
USE_WEBHOOK=false
WEBHOOK_URL=
PORT=3001
