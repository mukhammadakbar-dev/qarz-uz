# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Backend API base URL (must match the backend's PORT, which defaults to 4000)
API_BASE_URL=http://localhost:4000

# Must exactly match BOT_SHARED_SECRET on the backend (.env there). Lets this
# bot register personal accounts without the SMS-OTP step, since sharing a
# Telegram contact already proves the user controls the phone number.
# REQUIRED for /register to work — without it, registration from the bot
# fails because the backend falls back to requiring a normal OTP.
# Generate with: openssl rand -hex 24
BOT_SHARED_SECRET=

# Default UI language: uz | ru
DEFAULT_LANG=uz

# Public HTTPS URL of the qarz-web build, opened by the "📲 Mini-ilova" button.
# Telegram REQUIRES https:// on a web_app button and rejects http:// outright —
# leave this blank during local dev (no public HTTPS available) and the button
# is simply hidden rather than shown broken.
WEB_APP_URL=

# --- Webhook mode (optional; default is long polling) ---
USE_WEBHOOK=false
WEBHOOK_URL=
PORT=3001

# REQUIRED when USE_WEBHOOK=true (the bot refuses to start otherwise).
# Telegram echoes this in the X-Telegram-Bot-Api-Secret-Token header and the
# bot drops any update without it — the webhook endpoint is public, so this is
# the only thing stopping anyone who finds the URL from POSTing forged updates
# and impersonating arbitrary users.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# --- AI Assistant (ixtiyoriy) ---
# Tabiiy tildagi buyruqlarni tahlil qilish uchun AI kalitlari (Gemini yoki OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Xatolik monitoringi (Sentry) — ixtiyoriy ---
# Bo'sh = butunlay o'chiq. `npm start` uni --import orqali yuklaydi.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

