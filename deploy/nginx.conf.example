# Host-level nginx: terminates TLS and forwards to the web container on
# 127.0.0.1:8080 (which serves the SPA and proxies /api to the backend).
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/qarz
#   sudo ln -s /etc/nginx/sites-available/qarz /etc/nginx/sites-enabled/
#   # replace temirdaftar.uz with your domain throughout, then:
#   sudo certbot --nginx -d temirdaftar.uz -d www.temirdaftar.uz
#   sudo nginx -t && sudo systemctl reload nginx
#
# certbot rewrites the TLS block below with the real certificate paths.

# ---- HTTP: redirect everything to HTTPS ----
server {
    listen 80;
    listen [::]:80;
    server_name temirdaftar.uz www.temirdaftar.uz;

    # Leave this reachable over plain HTTP — certbot's renewal check uses it.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- HTTPS ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name temirdaftar.uz www.temirdaftar.uz;

    # certbot fills these in.
    ssl_certificate     /etc/letsencrypt/live/temirdaftar.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/temirdaftar.uz/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Tells browsers to refuse plain HTTP for this host from now on. Only add
    # `preload` once you are certain the domain will stay on HTTPS — getting
    # off the preload list takes months.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # helmet sets the rest of the security headers on API responses; these
    # cover the static SPA, which nginx serves directly.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 1m;

    # Don't advertise the exact nginx version to every scanner.
    server_tokens off;

    access_log /var/log/nginx/qarz.access.log;
    error_log  /var/log/nginx/qarz.error.log;

    location / {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # The backend counts proxy hops via TRUST_PROXY. This nginx APPENDS to
        # X-Forwarded-For, and the web container's nginx appends again — so the
        # app sees two hops. Set TRUST_PROXY=2 if you run this file; the
        # compose default of 1 assumes the web container is the only proxy.
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Receipt rendering (resvg) is the slowest endpoint; the default 60s
        # is ample, but be explicit rather than surprised.
        proxy_read_timeout 60s;
    }
}
