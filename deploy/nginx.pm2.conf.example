# Host nginx for the pm2 (no Docker) layout: serves the built SPA straight
# from qarz-web/dist and forwards API traffic to the backend on 127.0.0.1:4000.
# One origin for both, so CORS_ORIGINS can stay tight.
#
# Install:
#   sudo cp deploy/nginx.pm2.conf.example /etc/nginx/sites-available/qarz
#   sudo ln -s /etc/nginx/sites-available/qarz /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   # replace example.com with your domain throughout, then:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d example.com -d www.example.com
#
# certbot adds the 443 server block and the HTTP -> HTTPS redirect itself.
# The backend sits behind exactly one proxy here: set TRUST_PROXY=1.

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    root /srv/qarz/qarz-web/dist;
    index index.html;

    client_max_body_size 1m;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    access_log /var/log/nginx/qarz.access.log;
    error_log  /var/log/nginx/qarz.error.log;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ---- Backend: API, Click webhooks, one-time payment pages, health ----
    location /api/      { proxy_pass http://127.0.0.1:4000; proxy_read_timeout 60s; }
    location /pay/      { proxy_pass http://127.0.0.1:4000; }
    location /webhooks/ { proxy_pass http://127.0.0.1:4000; }
    location = /health  { proxy_pass http://127.0.0.1:4000; access_log off; }

    # ---- Static assets (fingerprinted by Vite, safe to cache for a year) ----
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ---- SPA: React Router owns every other path ----
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
