[Unit]
Description=TemirDaftar Telegram Bot Daemon
After=network.target postgresql.service

[Service]
Type=simple
User=acer
WorkingDirectory=/home/acer/projects/qarz-uz/qarz-bot
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
