# =============================================================
# Production environment for docker-compose.yml
#
#   cp .env.production.example .env
#   # fill in EVERY value marked REQUIRED, then:
#   docker compose up -d --build
#
# This file is read by compose and passed to the containers; the per-service
# .env files are for running them outside Docker.
#
# Generate secrets with:  openssl rand -hex 32
# Never reuse one value for two variables, and never commit the filled-in .env.
# =============================================================

# ---- Domain ----
# REQUIRED. The public HTTPS origin. Payment links are built from it, so a
# wrong value produces links that go nowhere.
PUBLIC_BASE_URL=https://temirdaftar.uz

# REQUIRED. Browser origins allowed to call the API, comma-separated.
# Leaving this EMPTY means any website can drive the API with a logged-in
# user's token. Include every hostname users actually reach the site on.
CORS_ORIGINS=https://temirdaftar.uz,https://www.temirdaftar.uz

# Proxies that append to X-Forwarded-For before a request reaches the app.
#   2 = host nginx (deploy/nginx.conf.example) + the web container   <- default
#   1 = web container only (TLS handled by a cloud load balancer)
# The auth rate limits are keyed on the resulting client IP: too low and every
# user shares one bucket, too high and a client can spoof past the limits.
TRUST_PROXY=2

# ---- Database ----
# REQUIRED. Used both to initialise Postgres and to connect to it. Changing
# DB_PASSWORD after the first `up` does NOT change the existing database's
# password — Postgres only applies it at initdb time.
DB_USER=qarz
DB_PASSWORD=
DB_NAME=qarz

# TLS to Postgres. false is correct for the bundled db container (private
# compose network, no published port). Set to true for a managed provider —
# they reject plaintext connections outright. See qarz-backend/src/config.
#   false | true | no-verify
DB_SSL=false
# Only when the provider signs with its own root: PEM text or a path to it.
# DB_SSL_CA=

# ---- JWT / signing secrets ----
# REQUIRED, all three. The backend REFUSES TO START in production if any is
# missing, shorter than 16 characters, or still set to an example value.
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_LINK_SECRET=

# Short access token, long refresh token: a leaked access token expires on its
# own, while a refresh token is only usable until the user is deactivated.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Business rules ----
TRIAL_DAYS=14
DEFAULT_SMS_LIMIT=30
PAYMENT_LINK_TTL_HOURS=48

# ---- Click (payments) ----
# OPTIONAL, and currently left empty on purpose: online payment is deferred,
# subscriptions are renewed by hand through the admin (see SUPPORT_* below).
# The online gateway counts as live only when all three are filled. While any
# is blank the API refuses to mint payment links and the web/bot hide the
# buttons that create them — a link with no working checkout behind it is
# worse than no link.
# When you do switch it on: values come from the Click merchant cabinet, the
# webhook signature is verified against CLICK_SECRET_KEY (a wrong value fails
# closed, never silently accepts), and Click's callback URL is
# {PUBLIC_BASE_URL}/webhooks/click/*
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# ---- Support contact (manual subscription payments) ----
# Telegram username (no @) that the Tariffs page and the bot's "Obuna" menu
# send a shop owner to in order to pay. This IS the payment flow while Click
# is off — leave it blank and an owner whose subscription lapsed has no way to
# reach anyone. SUPPORT_PHONE is an optional fallback shown alongside.
SUPPORT_TELEGRAM_USERNAME=
SUPPORT_PHONE=

# ---- Telegram Gateway (verification codes) ----
# Delivers the registration code into the user's Telegram from the
# @VerificationCodes service account — they stay on the website and type it in.
# Token and a topped-up balance come from https://gateway.telegram.org; this is
# a separate product from the bot, billed per message.
# Empty in production = the "Telegram orqali kod olish" button answers 503, and
# registration depends entirely on ESKIZ_* below.
TELEGRAM_GATEWAY_TOKEN=

# ---- Eskiz.uz (SMS) ----
# REQUIRED for overdue reminders and OTP delivery. While these are empty the
# backend does NOT send SMS — it logs the message and reports success, which
# is fine in development and silently broken in production.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender id, as approved by Eskiz.
ESKIZ_FROM=4546

# ---- Telegram ----
# REQUIRED. From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username without the @. Must match the bot the token belongs to, or the
# registration deep links send users to the wrong place.
TELEGRAM_BOT_USERNAME=tDaftar_bot

# REQUIRED. Shared between the backend and the bot; must match EXACTLY.
# It authenticates the bot for two things: skipping the registration OTP, and
# reading/writing the session store that holds every bot user's tokens. Treat
# it as a high-value credential — never expose it to the browser client.
#   openssl rand -hex 24
BOT_SHARED_SECRET=

# Bot UI default language: uz | ru
DEFAULT_LANG=uz

# ---- Mini App ----
# The public HTTPS site (same PUBLIC_BASE_URL above works). Blank = the
# "📲 Mini-ilova" button is hidden; Telegram rejects a web_app button whose url
# is not https://, so there is no working http:// fallback to fall back to.
WEB_APP_URL=

# ---- Telegram webhook mode (optional) ----
# Long polling is the default and needs no inbound port or certificate. Only
# switch if traffic justifies it; WEBHOOK_SECRET is mandatory when you do —
# the endpoint is public, and the secret is what stops forged updates.
USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---- Super admin (used by `npm run seed`) ----
# REQUIRED before seeding. The seed script refuses to run without a password
# and enforces at least 12 characters in production.
#   openssl rand -base64 24
SUPER_ADMIN_PHONE=998900000000
SUPER_ADMIN_PASSWORD=

# ---- Web build ----
# Empty = same-origin: the SPA calls /api on its own host and the web
# container's nginx forwards it to the backend. This is baked into the bundle
# at BUILD time, so changing it requires `docker compose build web`.
VITE_API_BASE_URL=

# ---- Backups (deploy/backup.sh) ----
BACKUP_RETENTION_DAYS=14

# ---- Xatolik monitoringi (Sentry) — ixtiyoriy ----
# Bo'sh qoldirilsa butunlay o'chiq: init() ham chaqirilmaydi, qo'shimcha yuk yo'q.
# DSN ni sentry.io da loyiha ochib olasiz. Ulanmasa, productiondagi xatoliklarni
# faqat `docker compose logs` orqali ko'rasiz.
SENTRY_DSN=
# Deploy qilingan versiya — xatolik qaysi versiyadan kelganini ko'rsatadi.
SENTRY_RELEASE=
# Performans trace'lari alohida hisoblanadi va tarif bo'yicha qimmat qismi.
# Standart 0 (o'chiq); kechikishni tekshirayotganda 0.05-0.1 qiling.
SENTRY_TRACES_SAMPLE_RATE=0
