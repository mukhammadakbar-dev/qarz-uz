# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qarz

# --- JWT / Security ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PAYMENT_LINK_SECRET=change-me-paylink

# --- Business rules ---
TRIAL_DAYS=14
DEFAULT_SMS_LIMIT=30
PAYMENT_LINK_TTL_HOURS=48

# --- Click (payment) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Eskiz.uz (SMS) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Shared secret the Telegram bot presents (as x-bot-secret header) to skip the
# registration SMS-OTP step, since a shared Telegram contact already proves
# phone ownership. MUST match the bot's own BOT_SHARED_SECRET exactly, and
# MUST be set in production — leaving it blank simply disables the bypass
# (the bot will then hit the normal OTP requirement and registration from the
# bot will fail with "Kod topilmadi"). Generate with: openssl rand -hex 24
BOT_SHARED_SECRET=
