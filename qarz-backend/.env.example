# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Comma-separated list of browser origins allowed to call this API.
# Leave EMPTY for local development (any origin). MUST be set in production —
# an open CORS policy lets any site drive the API with a logged-in user's token.
# Example: CORS_ORIGINS=https://temirdaftar.uz,https://www.temirdaftar.uz
CORS_ORIGINS=

# Number of reverse proxies in front of the app (nginx, Cloudflare, a load
# balancer...). req.ip is what the auth rate limits are keyed on: leave unset
# when the app is exposed directly, otherwise set it to the hop count, e.g. 1.
# Never guess high — trusting more hops than exist lets clients spoof their IP.
TRUST_PROXY=

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qarz

# TLS for the database connection:
#   false      (default) no TLS — a local Postgres, or one on a private network
#   true       TLS with the certificate verified. The right production setting.
#   no-verify  TLS without verifying the certificate. Encrypts the wire but does
#              not stop an active man-in-the-middle; only for providers that
#              issue self-signed certs and publish no CA bundle.
# Managed providers (Neon, Supabase, RDS, DigitalOcean) refuse plaintext
# connections, so leaving this false makes the app unable to connect at all.
DB_SSL=false

# Only needed with DB_SSL=true when the provider signs with its own root.
# Either the PEM text itself or a path to the bundle on disk.
DB_SSL_CA=

# --- JWT / Security ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PAYMENT_LINK_SECRET=change-me-paylink

# --- Business rules ---
TRIAL_DAYS=14
DEFAULT_SMS_LIMIT=30
PAYMENT_LINK_TTL_HOURS=48

# --- Click (payment) ---
# All three must be filled for the online gateway to count as live. While any
# of them is blank the API refuses to mint payment links (they would lead to a
# checkout that cannot take money) and the web/bot hide the buttons that make
# them. Subscriptions are renewed by hand in the meantime — see SUPPORT_* below.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Support contact (manual subscription payments) ---
# Telegram username (no @) a shop owner is sent to in order to pay for or renew
# a subscription. Leave blank only if you have another channel — with nothing
# set, the Tariffs page shows the plans but no way to reach anyone.
SUPPORT_TELEGRAM_USERNAME=
# Optional fallback shown next to the Telegram button.
SUPPORT_PHONE=

# --- Eskiz.uz (SMS) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Telegram Gateway (verification codes) ---
# Delivers registration codes into the user's Telegram from the
# @VerificationCodes service account, so they never leave the website.
# Token + a topped-up balance come from https://gateway.telegram.org
# (a separate product from the bot below, billed per message).
# Empty in development = the code is printed to the backend log instead of sent;
# empty in production = the "Telegram orqali kod olish" button returns 503.
TELEGRAM_GATEWAY_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Bot username (no @). Used to build the t.me deep link for the Telegram
# registration handshake, so it must match the bot users are sent to.
TELEGRAM_BOT_USERNAME=tDaftar_bot

# Shared secret the Telegram bot presents (as x-bot-secret header) to skip the
# registration SMS-OTP step, since a shared Telegram contact already proves
# phone ownership. MUST match the bot's own BOT_SHARED_SECRET exactly, and
# MUST be set in production — leaving it blank simply disables the bypass
# (the bot will then hit the normal OTP requirement and registration from the
# bot will fail with "Kod topilmadi"). Generate with: openssl rand -hex 24
BOT_SHARED_SECRET=

# --- Super Admin (`npm run seed` / `npm run reset-admin-password`) ---
# Both are REQUIRED — the scripts refuse to run without them rather than fall
# back to a default password that is public in this file. In production the
# password must be at least 12 characters.
# Generate one with: openssl rand -base64 24
SUPER_ADMIN_PHONE=998900000000
SUPER_ADMIN_PASSWORD=


# --- Xatolik monitoringi (Sentry) — ixtiyoriy ---
# Bo'sh = butunlay o'chiq. `npm start` uni --import orqali yuklaydi.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
