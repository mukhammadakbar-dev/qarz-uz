# Nusxa ko'chiring: cp .env.example .env  (dev). Production'da PM2/systemd env fayli, chmod 600.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Postgres. DATABASE_URL = `app` roli, MIGRATOR_DATABASE_URL = migratsiya roli.
DATABASE_URL=postgres://nasiya_app:nasiya_app@localhost:55432/nasiya
MIGRATOR_DATABASE_URL=postgres://nasiya_migrator:nasiya_migrator@localhost:55432/nasiya
# `nasiya_system` (BYPASSRLS): faqat cron va superadmin billing uchun
SYSTEM_DATABASE_URL=postgres://nasiya_system:nasiya_system@localhost:55432/nasiya

# Telegram. Dev: polling (default). Production: webhook (PUBLIC_BASE_URL majburiy, https).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_MODE=polling
# PUBLIC_BASE_URL=https://nasiya.example.uz
# MINIAPP_URL=https://nasiya.example.uz/app

# Kamida 32 belgi: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
INITDATA_MAX_AGE_SECONDS=86400

# Billing: 14 kun trial, oyiga 29 000 so'm, qo'lda to'lov
SUPERADMIN_TELEGRAM_IDS=
# Admin kontakti (qo'lda to'lov), +998XXXXXXXXX
SUPPORT_PHONE=
SUBSCRIPTION_PRICE_UZS=29000
TRIAL_DAYS=14

# Gemini: ikkalasi birga berilsa yoqiladi, aks holda faqat rule parser
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_TIMEOUT_MS=3000
# GEMINI_DAILY_LIMIT=300      # biznes boshiga kunlik chaqiruv; oshsa faqat rule parser
# GEMINI_MODE=always         # always | fallback (faqat rule aniq bo'lmaganda)

# SENTRY_DSN=
